# Copia este archivo a .env (make init lo hace por ti). NUNCA subas .env a git.

# UID de tu usuario en Linux/WSL para que los archivos de logs/ no queden como root
AIRFLOW_UID=50000

# Secretos de Airflow (make init los genera)
FERNET_KEY=
JWT_SECRET=

# Usuario administrador de la UI de Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Data warehouse
WAREHOUSE_DB=weather_dw
WAREHOUSE_USER=dw_user
WAREHOUSE_PASSWORD=dw_password

# Alertas de fallo: URL de un webhook entrante (JSON {"text": ...}, p. ej. Slack o Discord).
# Vacío = no se envía nada; el fallo queda solo en el log y en audit.pipeline_runs.
ALERT_WEBHOOK_URL=
